{
  "name": "qwik-demo-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/qwik-demo-app/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "qwik-nx:build",
      "options": {
        "runSequence": [
          "qwik-demo-app:build.client",
          "qwik-demo-app:build.ssr"
        ],
        "outputPath": "dist/packages/qwik-demo-app"
      },
      "configurations": {
        "preview": {}
      }
    },
    "build.client": {
      "executor": "@nx/vite:build",
      "options": {
        "outputPath": "dist/packages/qwik-demo-app/client",
        "configFile": "apps/qwik-demo-app/vite.config.ts",
        "emptyOutDir": true
      }
    },
    "build.ssr": {
      "executor": "@nx/vite:build",
      "defaultConfiguration": "preview",
      "options": {
        "outputPath": "dist/packages/qwik-demo-app/server",
        "configFile": "apps/qwik-demo-app/vite.config.ts",
        "emptyOutDir": true
      },
      "configurations": {
        "preview": {
          "ssr": "apps/qwik-demo-app/src/entry.preview.tsx",
          "mode": "production"
        }
      }
    },
    "preview": {
      "executor": "@nx/vite:preview-server",
      "options": {
        "buildTarget": "qwik-demo-app:build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "cwd": "apps/qwik-demo-app",
        "command": "vitest run --config vite.config.ts --passWithNoTests"
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "options": {
        "buildTarget": "qwik-demo-app:build.client",
        "mode": "ssr"
      }
    },
    "serve.debug": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --inspect-brk ../../node_modules/vite/bin/vite.js --mode ssr --force",
        "cwd": "apps/qwik-demo-app"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/qwik-demo-app/**/*.{ts,tsx,js,jsx}"]
      }
    }
  }
}
